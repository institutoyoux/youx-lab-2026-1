-- CONSULTAS COM JOIN

-- 33. O nome do livro, a categoria e a editora (LIVRO) – fazer uma view
create view dados_livros as
select
	lvr.nome as livro,
	ctg.nome as categoria,
	edt.nome as editora
from
	livro as lvr
left outer join
	editora as edt on lvr.ideditora = edt.ideditora
left outer join
	categoria as ctg on lvr.idcategoria = ctg.idcategoria

select * from dados_livros

-- 34. O nome do livro e o nome do autor (LIVRO_AUTOR) – fazer uma view.
create view livro_autor_view as
select
	lvr.nome as livro,
	atr.nome as autor
from
	livro_autor as lva
left outer join
	livro as lvr on lva.idlivro = lvr.idlivro
left outer join
	autor as atr on lva.idautor = atr.idautor

select * from livro_autor_view

