--agrupamento/join--
select 
	edt.nome as editora,
	count(lvr.idlivro) as quantidade
from 
	livro as lvr
left outer join 
	editora as edt on lvr.editora = edt.editora
group by 
	edt.nome


select 
	ctg.nome as categoria,
	count(lvr.idlivro) as quantidade
from 
	livro as lvr
left outer join 
	categoria as ctg on lvr.categoria = ctg.categoria
group by 
	ctg.nome



select 
	atr.nome as autor,
	count(lva.idlivro) as quantidade
from 
	livro_autor as lva
left outer join 
	autor as atr on lva.idautor = atr.idautor 
group by 
	atr.nome


select 
	aln.nome as aluno,
	count(emp.idemprestimo) as quantidade 
from 
	emprestimo as emp
left outer join
	aluno as aln on emp.idaluno = aln.idaluno 
group by 
	aln.nome



select 
	aln.nome as aluno,
	count(emp.valor) as valor
from 
	emprestimo as emp
left outer join
	aluno as aln on emp.idaluno = aln.idaluno 
group by 
	aln.nome




select 
	aln.nome as aluno,
	count(emp.valor) as valor
from 
	emprestimo as emp
left outer join
	aluno as aln on emp.idaluno = aln.idaluno 
group by 
	aln.nome
having 
	sum(emp.valor) > 12




