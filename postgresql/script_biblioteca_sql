--join--
create view livro_dados as
select 
	lvr.nome as livro,
	ctg.nome as categoria,
	edt.nome as editora
from 
	livro lvr
left outer join 
	categoria as ctg on lvr.idcategoria = ctg.idcategoria
left outer join 
	editora as edt on lvr.ideditora = edt.ideditora


create view livro_autor_view as
select 
	lvr.nome as livro,
	atr.nome as autor 
from 
	livro_autor as lva
left outer join 
	livro as lvr on lva.idlivro = lvr.idlivro
left outer join 
	autor as atr on lva.idautor = atr.idautor

select 
	lvr.nome as livro
from
