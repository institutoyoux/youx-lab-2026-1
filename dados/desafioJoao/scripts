select * from aluno;

select 
	us.nome as aluno
from 
	aluno as al
left join
	usuario as us on al.id = us.id


select 
	dic.nome as materia,
	us.nome as professor
from aluno as al
left join
turma as tu on al.id = tu.id
left join 
	rel_disciplina_turma as rel on rel.id_turma = tu.id
left join 
	Disciplina as dic on dic.id = rel.id_disciplina
left join
	professor as pr on dic.id_professor = pr.id
left join
	usuario as us on pr.id_usuario = us.id
where al.id = 67

